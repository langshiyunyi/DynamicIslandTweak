<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>DI_PREFS_TITLE</string>
    <key>items</key>
    <array>
        <!-- 总开关 -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>DI_SECTION_BASIC</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <false/>
            <key>defaults</key>
            <string>com.dynamicisland.tweak</string>
            <key>key</key>
            <string>islandEnabled</string>
            <key>label</key>
            <string>DI_ENABLE_MEDIA</string>
        </dict>

        <!-- 子页面：音乐岛设置 -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>DI_SECTION_CATEGORIES</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSLinkCell</string>
            <key>label</key>
            <string>DI_MUSIC_ISLAND</string>
            <key>detail</key>
            <string>PSListController</string>
            <key>bundle</key>
            <string>DynamicIslandPrefs</string>
            <key>isController</key>
            <true/>
            <key>plist</key>
            <string>MusicIsland</string>
        </dict>

        <!-- 子页面：消息岛设置 -->
        <dict>
            <key>cell</key>
            <string>PSLinkCell</string>
            <key>label</key>
            <string>DI_NOTIFICATION_ISLAND</string>
            <key>detail</key>
            <string>PSListController</string>
            <key>bundle</key>
            <string>DynamicIslandPrefs</string>
            <key>isController</key>
            <true/>
            <key>plist</key>
            <string>NotificationIsland</string>
        </dict>

        <!-- 子页面：其他设置 -->
        <dict>
            <key>cell</key>
            <string>PSLinkCell</string>
            <key>label</key>
            <string>DI_OTHER_SETTINGS</string>
            <key>detail</key>
            <string>PSListController</string>
            <key>bundle</key>
            <string>DynamicIslandPrefs</string>
            <key>isController</key>
            <true/>
            <key>plist</key>
            <string>OtherSettings</string>
        </dict>

        <!-- 保存和重置按钮 -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>DI_SECTION_SAVE_RESET</string>
            <key>footerText</key>
            <string>DI_FOOTER_SAVE_RESET</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>DI_SAVE_SETTINGS</string>
            <key>action</key>
            <string>saveAllPrefs</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>DI_RESET_DEFAULTS</string>
            <key>action</key>
            <string>resetAllPrefs</string>
        </dict>
    </array>
</dict>
</plist>
